# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
ADMIN_ID=admin_user_id
OWNER_USERNAME=@your_username

# Bot Settings
UPDATE_CHANNEL=https://t.me/TechTipsCode
SUPPORT_CHANNEL=https://t.me/EliteCodeLab

# Web Hosting (Choose one option)
# Option 1: Manual hostname/domain — uncomment and fill in if you have one
# HOST_URL=https://yourdomain.com

# Option 2: VPS with a fixed IP:port (if not using AUTO_IP)
# HOST_URL=http://203.0.113.42:14000

# Option 3: Auto-detect this box's public IP (default, recommended for a VPS) — just leave
# both HOST_URL lines above commented out and this stays on.
AUTO_IP=true

# Web Server Port (used by Flask)
# AUTO_IP will use this port automatically
# Default: 5000, Common VPS ports: 5000, 8000, 14000
PORT=14000

# Docker Settings
USE_DOCKER=false
DOCKER_IMAGE=hostingbot

# ==================== RESOURCE LIMITS ====================
# No cap on how many scripts can be checking/installing/running at once — every upload is
# attempted immediately, however many you send. The only real limit is per-script: this caps
# how much memory (in MB) any ONE script's process may use, via RLIMIT_AS, one value per user
# tier. This is what stops a single runaway or leaky script from consuming all the VPS's RAM
# by itself — if a script genuinely needs more than the box has, it fails with a clear
# "likely ran out of memory" message rather than silently being queued or throttled.
# Set to 0 for unlimited (not recommended on a small VPS — this previously defaulted to
# "unlimited" for the owner tier, which is what let testing bots collectively exhaust a 1GB box).
RAM_LIMIT_FREE_MB=250
RAM_LIMIT_PREMIUM_MB=400
RAM_LIMIT_ADMIN_MB=500
RAM_LIMIT_OWNER_MB=500
