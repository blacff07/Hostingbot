# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
ADMIN_ID=admin_user_id
OWNER_USERNAME=@your_username

# Bot Settings
UPDATE_CHANNEL=https://t.me/TechTipsCode
SUPPORT_CHANNEL=https://t.me/EliteCodeLab

# Web Hosting (Choose one option)
# Option 1: Manual hostname/domain
HOST_URL=https://yourdomain.com

# Option 2: VPS with port (if not using AUTO_IP)
# HOST_URL=http://203.0.113.42:14000

# Option 3: Auto-detect VPS IP (recommended for VPS)
# Leave HOST_URL empty and set AUTO_IP=true
AUTO_IP=true

# Web Server Port (used by Flask)
# AUTO_IP will use this port automatically
# Default: 5000, Common VPS ports: 5000, 8000, 14000
PORT=14000

# Docker Settings
USE_DOCKER=false
DOCKER_IMAGE=hostingbot

# ==================== RESOURCE LIMITS ====================
# MAX_RUNNING_SCRIPTS and MAX_CONCURRENT_EXECUTIONS are now AUTO-DETECTED at startup from
# this host's actual RAM/CPU (check the logs on boot to see what it picked) — you normally
# don't need to set either one. Only uncomment below to force a specific value instead of
# auto-scaling (e.g. you know your bots use more/less RAM than the RAM_LIMIT_* default assumes).

# MAX_RUNNING_SCRIPTS=3
# MAX_CONCURRENT_EXECUTIONS=3

# Per-process memory cap (in MB) enforced via RLIMIT_AS, one per user tier — this DOES have
# fixed defaults below, and also feeds the auto-scaling above (lower this and auto-scaling
# will allow more concurrent scripts within the same RAM; raise it and it'll allow fewer).
# Keeps a single runaway or leaky script from consuming all the VPS's RAM by itself. Set to 0
# for unlimited (not recommended on a small VPS — this previously defaulted to "unlimited" for
# the owner tier, which is what let testing bots collectively exhaust a 1GB box).
RAM_LIMIT_FREE_MB=250
RAM_LIMIT_PREMIUM_MB=400
RAM_LIMIT_ADMIN_MB=500
RAM_LIMIT_OWNER_MB=500
